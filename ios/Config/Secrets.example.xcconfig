// Copy to Secrets.xcconfig (gitignored). CI writes this file from environment variables.
// xcconfig treats "//" as a comment, so URLs are written "https:/$()/host".

// Apple Developer Team ID (App Store Connect → Membership). Needed for device builds only.
DEVELOPMENT_TEAM =

// OpenRouter key for the Ask assistant. Leave empty to use on-device answers only.
OPENROUTER_API_KEY =

// Optional model override (default in Base.xcconfig).
// OPENROUTER_MODEL = openai/gpt-6-luna
